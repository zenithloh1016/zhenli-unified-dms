{
  "name": "unicosec-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Windows desktop client for UNICOSEC - Company Secretarial Management System",
  "productName": "UNICOSEC",
  "main": "main.cjs",
  "author": "UNICOSEC",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.unicosec.desktop",
    "productName": "UNICOSEC",
    "executableName": "UNICOSEC",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "url-policy.cjs",
      "offline.html",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UNICOSEC",
      "artifactName": "UNICOSEC-Setup-${version}-x64.${ext}"
    },
    "portable": {
      "artifactName": "UNICOSEC-Portable-${version}-x64.${ext}"
    },
    "publish": null
  }
}
